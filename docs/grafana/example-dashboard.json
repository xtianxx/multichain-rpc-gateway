            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(rate(gateway_requests_total[1m])) by (chain)",
          "legendFormat": "{{chain}}",
          "range": true,
          "refId": "A"
